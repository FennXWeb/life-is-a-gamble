# Required for hosted dynamic dialogue and AI-generated character voices.
OPENAI_API_KEY=

# Low-usage defaults. Override only if a different model is intentionally selected.
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# LIAG Editor admin access. Comma-separated, exact email matches.
LIAG_EDITOR_ADMIN_EMAILS=

# Optional local-only identity; ignored in production. The email must also be
# present in LIAG_EDITOR_ADMIN_EMAILS.
LIAG_EDITOR_DEV_EMAIL=

# Server-only GitHub mount used by /editor. Use a fine-grained token with
# Contents read/write access to this repository. Never expose it to the client.
LIAG_GITHUB_REPOSITORY=FennXWeb/life-is-a-gamble
LIAG_GITHUB_TOKEN=
LIAG_GITHUB_BRANCH=testing
LIAG_GITHUB_DATA_PATH=game-data/editor-project.json
